{
  "name": "streamingservice",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "npm run prepare:player && react-native run-android",
    "ios": "npm run prepare:player && react-native run-ios",
    "lint": "eslint .",
    "start": "npm run prepare:player && react-native start",
    "test": "jest",
    "format": "prettier --write \"src/**/*.{js,ts,jsx,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,jsx,tsx}\"",
    "prepare:player": "npm --prefix ../StreamingServicePlayer run build && npm --prefix ../StreamingServicePlayer run generate:specs",
    "test:player-integration": "node tools/player-integration.test.cjs",
    "test:player-android-build": "node tools/player-android-build.test.cjs",
    "test:player-android-app": "node tools/player-android-app.test.cjs",
    "test:player-mobile": "tsc --project tsconfig.audio-migration.json && node --test tools/player-track-mapper.test.cjs tools/player-command-dispatcher.test.cjs tools/player-queue-projection.test.cjs tools/player-reporting.test.cjs tools/player-reporting-integration.test.cjs tools/player-source-preparation.test.cjs tools/player-native-composition.test.cjs tools/player-authentication.test.cjs tools/player-queue-intents.test.cjs tools/player-queue-rewrite.test.cjs tools/player-application-session.test.cjs tools/player-collections.test.cjs tools/player-runtime.test.cjs tools/player-network-client.test.cjs tools/player-view-recovery.test.cjs tools/player-selected-runtime.test.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "^4.5.7",
    "@react-native-cookies/cookies": "^6.2.1",
    "@react-native/new-app-screen": "0.80.2",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.21",
    "axios": "^1.11.0",
    "react": "19.1.0",
    "react-native": "0.80.2",
    "react-native-config": "^1.6.1",
    "react-native-fs": "^2.20.0",
    "react-native-image-colors": "^1.5.2",
    "react-native-inappbrowser-reborn": "^3.7.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.35.9",
    "react-native-paper": "^5.14.5",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.13.1",
    "react-native-svg": "^15.12.0",
    "react-native-toast-message": "^2.3.3",
    "streaming-service-player": "file:../StreamingServicePlayer"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "19.1.1",
    "@react-native-community/cli-platform-android": "19.1.1",
    "@react-native-community/cli-platform-ios": "19.1.1",
    "@react-native/babel-preset": "0.80.2",
    "@react-native/eslint-config": "0.80.2",
    "@react-native/metro-config": "0.80.2",
    "@react-native/typescript-config": "0.80.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "^2.8.8",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "19.1.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
