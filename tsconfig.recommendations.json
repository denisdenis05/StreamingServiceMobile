{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": [],
    "rootDir": "src/services",
    "outDir": ".build/recommendations"
  },
  "include": ["src/services/recommendations/**/*.ts"]
}
